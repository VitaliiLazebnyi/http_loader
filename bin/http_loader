#!/usr/bin/env ruby
# frozen_string_literal: true

# Copyright (c) 2026 Vitalii Lazebnyi

# Executable of the gem: runs the `client`, `server` or `harness` subcommand (see HttpLoader::CLI).

# Opt out of only the "experimental feature" warning category: the async fiber scheduler does non-blocking
# file IO through Ruby's IO::Buffer, which Ruby 4.0 still flags as experimental. Deprecation and performance
# warnings stay on.
Warning[:experimental] = false

lib = File.expand_path('../lib', __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
require 'http_loader/cli'

exit(HttpLoader::CLI.run(ARGV))
