#!/usr/bin/env bash
# Pre-commit hook: runs the fast gates. Install with: git config core.hooksPath .githooks
set -euo pipefail

echo "==> RSpec (100% line + branch coverage)..."
CI=true bundle exec rspec --format progress

echo "==> RuboCop..."
bundle exec rubocop

echo "==> Forbidding inline suppressions..."
script/forbidden_suppressions.sh

echo "==> Sorbet type-check..."
bundle exec rake typecheck

echo "==> Reek and Flay..."
bundle exec rake reek flay

echo "==> All checks passed."
